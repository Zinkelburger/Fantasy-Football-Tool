{
  "manifest_version": 3,
  "name": "Draft Assistant: Player Extractor",
  "version": "1.0.0.2",
  "description": "Extracts player names and sends them to a local Python server. Open source at https://github.com/Zinkelburger/Fantasy-Football-Tool",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },

  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://sleeper.com/draft/*",
        "https://sleeper.com/drafts/*",
        "https://sleeper.app/draft/*",
        "https://sleeper.app/drafts/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost/*"
  ]
}