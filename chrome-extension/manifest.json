{
  "manifest_version": 3,
  "name": "Draft Assistant: Player Extractor",
  "version": "1.3.0",
  "description": "Extracts draft picks (ESPN, Sleeper, Yahoo, NFL.com, CBS) and relays them to the Fantasy Football web app tab (and the local Go app if running). Open source at https://github.com/Zinkelburger/Fantasy-Football-Tool",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },

  "permissions": ["cookies", "tabs", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*"
      ],
      "js": ["espn-draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sleeper.com/draft/nfl/*",
        "https://sleeper.app/draft/nfl/*"
      ],
      "js": ["content.js", "sleeper-draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/*"
      ],
      "js": ["content.js", "draft-common.js", "yahoo-draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fantasy.nfl.com/*"
      ],
      "js": ["content.js", "draft-common.js", "nfl-draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.football.cbssports.com/*"
      ],
      "js": ["content.js", "draft-common.js", "cbs-draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://foss.football/*",
        "https://www.foss.football/*",
        "https://zinkelburger.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*.espn.com/*",
    "https://espn.com/"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "draft-assistant@foss.football",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
