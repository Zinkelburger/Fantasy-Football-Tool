# ESPN league (private league reads + every write need the two cookies).
# In a logged-in espn.com tab: DevTools -> Application -> Cookies -> espn.com,
# copy the values of espn_s2 and SWID (SWID includes the braces).
ESPN_LEAGUE_ID=112618
ESPN_S2=
ESPN_SWID={...}
# Optional: your team id from league_settings(); found from SWID otherwise.
ESPN_TEAM_ID=
# Optional: FantasyPros public API key for expert consensus ranks.
# Without it the same consensus comes from the keyless fftiers bucket
# (fftiers.py), with tiers but no start/sit grades. Nothing breaks unset.
FANTASYPROS_API_KEY=
# Optional, only for Bluesky keyword search; public author feeds need no key.
BSKY_HANDLE=
BSKY_APP_PASSWORD=
